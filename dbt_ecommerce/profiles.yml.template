# profiles.yml.template
# ---------------------
# Copy this file to ~/.dbt/profiles.yml (or set DBT_PROFILES_DIR).
# Fill in your Snowflake credentials - never commit real credentials.

ecommerce_snowflake:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      password: "{{ env_var('SNOWFLAKE_PASSWORD') }}"
      role: "{{ env_var('SNOWFLAKE_ROLE', 'SYSADMIN') }}"
      database: ECOMMERCE_DB
      warehouse: COMPUTE_WH
      schema: SILVER          # default schema; overridden per model layer
      threads: 4
      client_session_keep_alive: false

    prod:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      password: "{{ env_var('SNOWFLAKE_PASSWORD') }}"
      role: SYSADMIN
      database: ECOMMERCE_DB
      warehouse: COMPUTE_WH
      schema: SILVER
      threads: 8
      client_session_keep_alive: false
