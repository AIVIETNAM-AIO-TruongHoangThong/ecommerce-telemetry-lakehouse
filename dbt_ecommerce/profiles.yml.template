# profiles.yml.template
# ---------------------
# Copy this file to ~/.dbt/profiles.yml (or set DBT_PROFILES_DIR).
# Configured for Trino querying Apache Iceberg catalog on MinIO.

ecommerce_trino:
  target: dev
  outputs:
    dev:
      type: trino
      method: none
      user: "{{ env_var('TRINO_USER', 'admin') }}"
      password: "{{ env_var('TRINO_PASSWORD', '') }}"
      host: "{{ env_var('TRINO_HOST', 'localhost') }}"
      port: "{{ env_var('TRINO_PORT', 8080) | int }}"
      database: iceberg
      schema: lakehouse
      threads: 4

    prod:
      type: trino
      method: none
      user: "{{ env_var('TRINO_USER', 'admin') }}"
      password: "{{ env_var('TRINO_PASSWORD', '') }}"
      host: "{{ env_var('TRINO_HOST', 'trino') }}"
      port: "{{ env_var('TRINO_PORT', 8080) | int }}"
      database: iceberg
      schema: lakehouse
      threads: 8
