# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Environment secrets - never commit!
.env

# Data directory (created dynamically at runtime; never committed)
data/

# JAR files (downloaded by Docker)
docker/spark/jars/*.jar

# Terraform state & local overrides
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/terraform.tfstate
terraform/terraform.tfstate.backup
terraform/*.tfvars

# dbt generated artifacts
dbt_ecommerce/target/
dbt_ecommerce/dbt_packages/
dbt_ecommerce/logs/
dbt_ecommerce/profiles.yml   # contains real credentials; use profiles.yml.template

# macOS
.DS_Store

# IDE
.idea/
.vscode/

