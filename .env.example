# ==============================================================================
# MinIO / S3A Lakehouse Storage Configuration
# ==============================================================================
# Use http://localhost:9000 when running locally, or http://minio:9000 inside Docker
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=your_minio_username
MINIO_SECRET_KEY=your_minio_password
MINIO_BUCKET=ecommerce-lakehouse
MINIO_WAREHOUSE_PATH=s3a://ecommerce-lakehouse/iceberg
MINIO_DLQ_PATH=s3a://ecommerce-lakehouse/dlq

# ==============================================================================
# Spark Cluster Configuration
# ==============================================================================
# Use local[4] when running directly on host, or spark://spark-master:7077 inside Docker
SPARK_MASTER_URL=local[4]
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=4g
SPARK_EXECUTOR_CORES=2
# Set JAVA_HOME if your default system Java is not Java 17 (e.g., /opt/homebrew/opt/openjdk@17 or /usr/lib/jvm/java-17)
# JAVA_HOME=

# ==============================================================================
# Trino / dbt Configuration
# ==============================================================================
TRINO_HOST=localhost
TRINO_PORT=8080
TRINO_USER=admin
TRINO_PASSWORD=
